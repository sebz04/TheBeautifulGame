{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "foundryResourceId": { "value": "${FOUNDRY_RESOURCE_ID}" },
    "foundryProjectEndpoint": { "value": "${FOUNDRY_PROJECT_ENDPOINT}" },
    "foundryModelDeployment": { "value": "${FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1-mini}" },
    "alertEmail": { "value": "${ALERT_EMAIL}" },
    "createBudget": { "value": "${CREATE_BUDGET=true}" }
  }
}
